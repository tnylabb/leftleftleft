# --- Game server -------------------------------------------------------------
# Port of the Node.js / Socket.IO server (also serves the production build).
# In development Vite proxies /socket.io to it.
GAME_PORT=3001
# Comma separated list of allowed origins for Socket.IO CORS ("*" = any).
# Only needed when the client is served from a different origin than the server.
CORS_ORIGIN=*
# Seconds a disconnected player keeps their seat before the room releases it.
RECONNECT_GRACE_SECONDS=60
# Player statistics: a Postgres connection string (hosted Postgres in production, e.g. Neon / Supabase).
# Empty = an embedded Postgres in STATS_DB_DIR (default ./.data/stats) - not persistent on Render free.
DATABASE_URL=
# DATABASE_SSL=no-verify
# STATS_DB_DIR=./.data/stats
# Versus: how long the other cars have after the winner (ms).
# FINISH_WINDOW_MS=60000

# --- Client (Vite) -----------------------------------------------------------
# Port of the Vite dev server.
CLIENT_PORT=5173
# Optional: connect to a game server on another origin, e.g. https://my-server.example.com
# Leave empty to use the page's own origin (recommended).
VITE_SERVER_URL=
# Optional: comma separated STUN/TURN URLs used by built-in WebRTC voice chat.
VITE_STUN_URLS=stun:stun.l.google.com:19302
